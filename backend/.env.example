# Port and host settings
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated exact origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared API key for protecting /api endpoints in deployed environments
DPI_API_KEY=

# AI Copilot Keys (Optional - Intelligent fallback runs offline if not provided)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Engine Path (defaults to ../Packet_analyzer/dpi_engine.exe or ./dpi_engine on Linux)
DPI_ENGINE_PATH=
