# ==============================================================================
# Deep Packet Inspection (DPI) & Streaming AI Copilot Platform
# Environment Configuration Template
# Copy this file to '.env' and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Comma-separated allowed origins for CORS (e.g. local frontend & deployed domain)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dpi-packet-analyser.vercel.app

# Optional shared API key for protecting /api endpoints in production
DPI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Supabase or SQLite fallback)
# ------------------------------------------------------------------------------
# Local Development default (if left empty, automatically creates and uses local sqlite:///./dpi.db):
# DATABASE_URL=sqlite:///./dpi.db

# Production (Supabase / Render PostgreSQL):
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth Configuration (for Email, Google, and GitHub Sign In)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Docker Compose PostgreSQL Settings
POSTGRES_USER=dpi_user
POSTGRES_PASSWORD=dpi_secret_password
POSTGRES_DB=dpi_db

# ------------------------------------------------------------------------------
# 3. AI Copilot Keys (Optional - Intelligent fallback runs offline if blank)
# ------------------------------------------------------------------------------
# Groq API Key (Ultra-fast 500+ tokens/sec LPU streaming)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Frontend Configuration
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. Core C++ DPI Engine Path (Optional override)
# ------------------------------------------------------------------------------
# Defaults to ../Packet_analyzer/dpi_engine.exe (Windows) or ./dpi_engine (Linux)
DPI_ENGINE_PATH=

